{
  "info": {
    "name": "TP1 Pharmacie",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Exécuter dans l’ordre sur une base de TP initialisée par database/seed.sql. Modifie les données 2 et 3 conformément à la page 6. Aucun secret. Les IDs des créations sont capturés pour permettre plusieurs exécutions."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categorieId",
      "value": ""
    },
    {
      "key": "fournisseurId",
      "value": ""
    },
    {
      "key": "produitId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Lister les produits",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produits"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Liste JSON\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Créer catégorie (page 5)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Anti-inflammatoires\",\n  \"description\": \"Médicaments pour réduire l'inflammation et la douleur.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"categorieId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Créer fournisseur (page 5)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/fournisseurs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Novartis\",\n  \"contact\": \"contact@novartis.com\",\n  \"adresse\": \"Genève, Suisse\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"fournisseurId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Créer Voltaren (page 5, IDs dynamiques)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produits",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Voltaren 50mg\",\n  \"description\": \"Anti-inflammatoire pour douleurs musculaires et articulaires.\",\n  \"prix\": 58.9,\n  \"codeBarre\": \"VOLTA50-2025\",\n  \"dateExpiration\": \"2026-12-15\",\n  \"categorie\": {\n    \"id\": {{categorieId}}\n  },\n  \"fournisseur\": {\n    \"id\": {{fournisseurId}}\n  },\n  \"detailProduit\": {\n    \"fabricant\": \"Novartis\",\n    \"paysOrigine\": \"Suisse\",\n    \"composition\": \"Diclofénac sodique 50 mg\",\n    \"dosage\": \"50 mg\",\n    \"indications\": \"Traitement des douleurs musculaires\"\n  },\n  \"tags\": [\n    {\n      \"id\": 1\n    },\n    {\n      \"id\": 3\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"produitId\", pm.response.json().id);",
              "pm.test(\"Relations et détails\", () => { const p = pm.response.json(); pm.expect(p.detailProduit.fabricant).to.eql(\"Novartis\"); pm.expect(p.tags.length).to.eql(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Consulter Voltaren",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produits/{{produitId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Catégorie utilisée : conflit",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{categorieId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Modifier Doliprane (page 6)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produits/2",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Doliprane 500mg (Nouveau)\",\n  \"description\": \"Antalgique et antipyrétique — nouvelle formule 2025.\",\n  \"prix\": 27,\n  \"codeBarre\": \"DLP500-NEW\",\n  \"dateExpiration\": \"2026-05-10\",\n  \"categorie\": {\n    \"id\": 2\n  },\n  \"fournisseur\": {\n    \"id\": 2\n  },\n  \"detailProduit\": {\n    \"fabricant\": \"Bayer\",\n    \"paysOrigine\": \"Allemagne\",\n    \"composition\": \"Paracétamol 500 mg\",\n    \"dosage\": \"500 mg\",\n    \"indications\": \"Douleur et fièvre légère\"\n  },\n  \"tags\": [\n    {\n      \"id\": 1\n    },\n    {\n      \"id\": 3\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
